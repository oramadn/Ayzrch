#!/usr/bin/env bash
# Dynamic Cursors plugin installer, in the shape of Orbit's other plugin
# installers. Upstream documents a manual checkout + make; Orbit ships no
# installer for it, so this one is Ayzrch-owned.

set -euo pipefail

repo_url="https://github.com/virtcode/hypr-dynamic-cursors.git"
repo_commit="5a224284872208b5324759d535d65061043725de"
reference_hyprland="efb50993780079460b0cbed1363e2166a2de1d9f"
source_dir="${ORBIT_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/orbit-hyprland-plugins}/dynamic-cursors-$repo_commit"
plugin_dir="${ORBIT_PLUGIN_DIR:-$HOME/.local/share/hyprland/plugins}"

command -v git >/dev/null || { printf '%s\n' 'error: git is required' >&2; exit 1; }
command -v make >/dev/null || { printf '%s\n' 'error: make is required' >&2; exit 1; }
command -v g++ >/dev/null || { printf '%s\n' 'error: g++ is required' >&2; exit 1; }
command -v pkg-config >/dev/null || { printf '%s\n' 'error: pkg-config is required' >&2; exit 1; }

for package in hyprland pixman-1 libdrm; do
    pkg-config --exists "$package" || {
        printf 'error: required development package is unavailable: %s\n' "$package" >&2
        exit 1
    }
done

if command -v hyprctl >/dev/null && command -v python3 >/dev/null; then
    running_commit=$(hyprctl version -j 2>/dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin).get("commit", ""))' 2>/dev/null || true)
    if [[ -n "$running_commit" && "$running_commit" != "$reference_hyprland" ]]; then
        printf 'warning: building Dynamic Cursors for Hyprland ABI %s, not validated reference %s\n' "$running_commit" "$reference_hyprland" >&2
    fi
fi

if [[ ! -d "$source_dir/.git" ]]; then
    mkdir -p "${source_dir%/*}"
    git clone --filter=blob:none "$repo_url" "$source_dir"
fi

git -C "$source_dir" fetch --quiet --depth=1 origin "$repo_commit"
git -C "$source_dir" checkout --quiet --detach "$repo_commit"
git -C "$source_dir" reset --quiet --hard "$repo_commit"
[[ "$(git -C "$source_dir" rev-parse HEAD)" == "$repo_commit" ]] || {
    printf '%s\n' 'error: Dynamic Cursors checkout did not reach the pinned commit' >&2
    exit 1
}

(
    cd "$source_dir"
    make clean >/dev/null 2>&1 || true
    make all
    mkdir -p "$plugin_dir"
    install -m 0755 out/dynamic-cursors.so "$plugin_dir/dynamic-cursors.so"
)
printf '%s\n' "Installed $plugin_dir/dynamic-cursors.so for the next Hyprland session; the running compositor was not touched."
