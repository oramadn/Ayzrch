def install_active_gtk(palette_name: str) -> None:
    generated = GENERATED / palette_name
    write_atomic(GTK3_ACTIVE, (generated / "gtk-3.0.css").read_text())
    write_atomic(GTK4_ACTIVE, (generated / "gtk-4.0.css").read_text())


def update_gtk_font_setting(path: Path, family: str, size: float) -> None:
    try:
        text = path.read_text()
    except OSError:
        text = "[Settings]\n"
    value = f"{family} {size:g}"
    lines = text.splitlines()
    replaced = False
    for index, line in enumerate(lines):
        if line.strip().startswith("gtk-font-name="):
            lines[index] = f"gtk-font-name={value}"
            replaced = True
            break
    if not replaced:
        lines.append(f"gtk-font-name={value}")
    write_atomic(path, "\n".join(lines).rstrip() + "\n")


def update_gtk_resource_settings(path: Path, resources: dict) -> None:
    try:
        text = path.read_text()
    except OSError:
        text = "[Settings]\n"
    text = update_ini_section(text, "Settings", {
        "gtk-icon-theme-name": resources["icons"]["theme"],
        "gtk-cursor-theme-name": XCURSOR_FALLBACK_THEME,
        "gtk-cursor-theme-size": str(resources["cursor"]["size"]),
    })
    write_atomic(path, text)


def update_qt6ct_fonts(path: Path, typography: dict) -> None:
    try:
        text = path.read_text()
    except OSError:
        text = ""
    text = update_ini_section(text, "Fonts", {
        "fixed": f'"{qfont_value(typography["monospace"])}"',
        "general": f'"{qfont_value(typography["body"])}"',
    })
    write_atomic(path, text)


def update_qt6ct_resources(path: Path, resources: dict) -> None:
    try:
        text = path.read_text()
    except OSError:
        text = ""
    text = update_ini_section(text, "Appearance", {
        "icon_theme": resources["icons"]["theme"],
    })
    write_atomic(path, text)


def update_gnome_font_settings(typography: dict) -> None:
    # GSettings is the native GNOME/GTK preference path. Never touch it during
    # disposable generator tests or when the schema is unavailable.
    if HOME != Path.home() or not shutil.which("gsettings"):
        return
    for key, role in (("font-name", "body"), ("monospace-font-name", "monospace")):
        value = json.dumps(
            f'{typography[role]["family"]} {float(typography[role]["size"]):g}'
        )
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", key, value],
            check=False,
            capture_output=True,
            text=True,
        )


def update_gnome_resource_settings(resources: dict) -> None:
    """Update active GNOME settings without creating a second Orbit owner."""
    if HOME != Path.home() or not shutil.which("gsettings"):
        return
    values = {
        "icon-theme": resources["icons"]["theme"],
        "cursor-theme": XCURSOR_FALLBACK_THEME,
        "cursor-size": str(resources["cursor"]["size"]),
    }
    for key, value in values.items():
        result = subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", key, value if key == "cursor-size" else json.dumps(value)],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise ValueError(result.stderr.strip() or f"Could not update GSettings {key}")


FLATPAK_ICON_BRIDGE_APPS = (
    "io.missioncenter.MissionCenter",
    "org.gnome.FileRoller",
    "net.davidotek.pupgui2",
)


def update_flatpak_icon_bridges(resources: dict) -> None:
    """Refresh only the Flatpak bridges already configured by Orbit helpers."""
    flatpak = shutil.which("flatpak")
    if not flatpak:
        return
    theme = resources["icons"]["theme"]
    for app in FLATPAK_ICON_BRIDGE_APPS:
        shown = subprocess.run(
            [flatpak, "override", "--user", "--show", app],
            check=False,
            capture_output=True,
            text=True,
        )
        if shown.returncode != 0:
            continue
        if "ICON_THEME=" in shown.stdout:
            result = subprocess.run(
                [flatpak, "override", "--user", f"--env=ICON_THEME={theme}", app],
                check=False,
                capture_output=True,
                text=True,
            )
            if result.returncode != 0:
                raise ValueError(result.stderr.strip() or f"Could not update Flatpak icon theme for {app}")

    # ProtonUp-Qt uses the existing copied KDE bridge rather than the host
    # hyprqt6engine plugin, so refresh it only when that bridge already exists.
    kde_bridge = HOME / ".var/app/net.davidotek.pupgui2/config/kdeglobals"
    if kde_bridge.is_file() and not kde_bridge.is_symlink():
        write_atomic(kde_bridge, kdeglobals_content(typography_settings(), resources))


def install_active_typography_adapters(palette_name: str, typography: dict | None = None) -> None:
    typography = typography or typography_settings()
    resources = resource_settings()
    install_active_gtk(palette_name)
    update_gtk_font_setting(HOME / ".config/gtk-3.0/settings.ini", typography["body"]["family"], typography["body"]["size"])
    update_gtk_font_setting(HOME / ".config/gtk-4.0/settings.ini", typography["body"]["family"], typography["body"]["size"])
    update_gtk_resource_settings(HOME / ".config/gtk-3.0/settings.ini", resources)
    update_gtk_resource_settings(HOME / ".config/gtk-4.0/settings.ini", resources)
    update_gnome_font_settings(typography)
    update_gnome_resource_settings(resources)
    generated = GENERATED / palette_name
    write_atomic(HOME / ".config/hypr/hyprqt6engine.conf", hyprqt6engine_config(typography, resources))
    update_qt6ct_fonts(HOME / ".config/qt6ct/qt6ct.conf", typography)
    update_qt6ct_resources(HOME / ".config/qt6ct/qt6ct.conf", resources)
    write_atomic(HOME / ".config/kdeglobals", kdeglobals_content(typography, resources))
    write_atomic(HOME / ".config/Trolltech.conf", trolltech_content(typography))
    write_atomic(KITTY_ACTIVE, (generated / "kitty.conf").read_text())
    update_wezterm_font_settings(WEZTERM_CONFIG_ACTIVE, typography)


def install_active_resource_adapters(palette_name: str, resources: dict | None = None) -> None:
    resources = resources or resource_settings()
    update_gtk_resource_settings(HOME / ".config/gtk-3.0/settings.ini", resources)
    update_gtk_resource_settings(HOME / ".config/gtk-4.0/settings.ini", resources)
    update_gnome_resource_settings(resources)
    typography = typography_settings()
    write_atomic(
        HOME / ".config/hypr/hyprqt6engine.conf",
        hyprqt6engine_config(typography, resources),
    )
    update_qt6ct_resources(HOME / ".config/qt6ct/qt6ct.conf", resources)
    write_atomic(HOME / ".config/kdeglobals", kdeglobals_content(typography, resources))
    update_flatpak_icon_bridges(resources)


def update_wezterm_font_settings(path: Path, typography: dict) -> None:
    try:
        text = path.read_text()
    except OSError:
        return
    lines = text.splitlines()
    family_line = f"config.font = wezterm.font({json.dumps(typography['monospace']['family'])})"
    size_line = f"config.font_size = {float(typography['monospace']['size']):g}"
    family_seen = False
    size_seen = False
    for index, line in enumerate(lines):
        if line.strip().startswith("config.font ="):
            lines[index] = family_line
            family_seen = True
        elif line.strip().startswith("config.font_size ="):
            lines[index] = size_line
            size_seen = True
    return_line = next((index for index, line in enumerate(lines) if line.strip() == "return config"), len(lines))
    if not family_seen:
        lines.insert(return_line, family_line)
        return_line += 1
    if not size_seen:
        lines.insert(return_line, size_line)
    write_atomic(path, "\n".join(lines).rstrip() + "\n")


def refresh_auxiliary_adapters(palette_name: str) -> None:
    command = HOME / ".local/bin/generate-hyprlock-colors"
    if command.is_file():
        subprocess.run([str(command), palette_name], check=True)


def install_active_adapters(palette_name: str) -> None:
    typography = typography_settings()
    install_active_typography_adapters(palette_name, typography)
    install_active_shape_adapters(palette_name)


def main() -> None:
    parser = argparse.ArgumentParser(prog="orbit-theme")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("current", help="print the selected palette")
    subparsers.add_parser("list", help="list available palettes")
    generate_command = subparsers.add_parser("generate", help="generate toolkit adapters")
    generate_command.add_argument("palette", nargs="?", default=None)
    refresh_gtk_command = subparsers.add_parser("refresh-gtk", help="refresh GTK adapters from appearance state")
    refresh_gtk_command.add_argument("palette", nargs="?", default=None)
    refresh_typography_command = subparsers.add_parser(
        "refresh-typography",
        help="refresh canonical typography and all established toolkit adapters",
    )
    refresh_typography_command.add_argument("palette", nargs="?", default=None)
    refresh_resources_command = subparsers.add_parser(
        "refresh-resources",
        help="refresh canonical icon/cursor resource adapters",
    )
    refresh_resources_command.add_argument("palette", nargs="?", default=None)
    refresh_shape_command = subparsers.add_parser(
        "refresh-shape",
        help="refresh canonical shape adapters",
    )
    refresh_shape_command.add_argument("palette", nargs="?", default=None)
    apply_command = subparsers.add_parser("apply", help="select and generate a palette")
    apply_command.add_argument("palette")
    args = parser.parse_args()

    if args.command == "current":
        print(selected_palette())
    elif args.command == "list":
        print("noctalia")
    elif args.command == "generate":
        generate(args.palette or selected_palette())
    elif args.command == "refresh-gtk":
        palette = args.palette or selected_palette()
        refresh_gtk(palette)
    elif args.command == "refresh-typography":
        palette = args.palette or selected_palette()
        refresh_typography(palette)
    elif args.command == "refresh-resources":
        palette = args.palette or selected_palette()
        refresh_resources(palette)
    elif args.command == "refresh-shape":
        palette = args.palette or selected_palette()
        refresh_shape(palette)
    elif args.command == "apply":
        if args.palette not in ("noctalia", "noctalia.lua"):
            raise SystemExit("Orbit accepts only the active Noctalia palette")
        generate("noctalia")
        install_active_adapters("noctalia")
        # Regenerate the separate Hyprlock artifact from semantic.json.
        home = Path.home()
        hyprlock_script = home / ".local/bin/generate-hyprlock-colors"
        if hyprlock_script.is_file():
            subprocess.run([str(hyprlock_script), "noctalia"], check=True)
        greeter_sync = home / ".local/bin/orbit-sync-noctalia-greeter"
        if greeter_sync.is_file():
            # Keep the greeter fed from the same current lock background source.
            subprocess.run([str(greeter_sync)], check=False)


if __name__ == "__main__":
    main()
