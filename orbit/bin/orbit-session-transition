#!/usr/bin/env bash

# Authoritative session lifecycle coordinator. Workspace staging is the only
# compositor-owned visual transition surface; no Orbit layer-shell curtain is used.
set -u

state_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/orbit-session-transition"
state_file="$state_dir/state"
lock_file="$state_dir/lock"
staging="$HOME/.local/bin/orbit-transition-workspace"
session_workspaces="$HOME/.local/bin/orbit-session-workspaces"
session_chrome="$HOME/.local/bin/orbit-noctalia-session-chrome"
session_sound="$HOME/.local/bin/play-session-sound"
wallpaper_status="$HOME/.cache/orbit-wallpaper-engine/status"
wallpaper_control="$HOME/.cache/orbit-wallpaper-engine/control"
wallpaper_events="$HOME/.cache/orbit-wallpaper-engine/events"
# Workspace staging is Hyprland's visual transition surface: windows are parked
# on a private workspace so the compositor animates the scene away. niri has no
# equivalent that can be driven from outside, so under niri the transition keeps
# its sound, chrome and wallpaper phases and the staging phases are absent
# rather than failing.
if [ -n "${NIRI_SOCKET:-}" ]; then
    compositor=niri
    session_target=niri-session.target
else
    compositor=hyprland
    session_target=hyprland-session.target
fi
hyprlock_bin="${ORBIT_HYPRLOCK_BIN:-hyprlock}"
wallpaper_reader_pid=""
wallpaper_event_file=""
visual_overlap_seconds="0.15"

mkdir -p "$state_dir"

log() {
    printf 'orbit-session-transition: %s\n' "$*" >&2
}

now_ms() {
    date +%s%3N
}

set_state() {
    local state="$1" detail="${2:-}"
    printf 'state=%s\ndetail=%s\n' "$state" "$detail" >"$state_file.tmp"
    mv -f "$state_file.tmp" "$state_file"
}

status() {
    if [ -f "$state_file" ]; then
        cat "$state_file"
    else
        printf 'state=idle\ndetail=none\n'
    fi
}

deadline_after() {
    printf '%s\n' "$(( $(date +%s) + $1 ))"
}

wait_noctalia_ready() {
    local deadline="$1"
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if noctalia msg status >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.05
    done
    return 1
}

# The Orbit Wallpaper Engine is optional, and on installs that render wallpaper
# another way — awww, for one — its unit sits failed or inactive forever. Such a
# unit will never become ready inside a deadline, so polling one only buys dead
# air: every transition paid two of these waits, which is most of the pause
# between the shell chrome disappearing and the lock actually engaging.
# Hyprland animates the lock through workspace staging: the windows slide away
# and the compositor draws the motion. niri has no equivalent that can be driven
# from outside, but it has something better suited — do-screen-transition freezes
# the current frame, and cross-fades from it to whatever is on screen once the
# delay elapses. It is issued as late as possible — immediately before the locker
# runs — so the frame it captures is the untouched desktop and the fade lands on
# the lock screen itself, rather than on a desktop caught mid-teardown.
#
# The delay has to outlast the lock surface coming up. Overshooting only holds
# the frozen frame a little longer; undershooting shows the bare desktop.
# Hyprland hides the bar and dock for the lock because hyprlock does not reliably
# sit above layer-shell surfaces. Under niri the lock is an Overlay-layer surface
# and the bar and dock are Top, so the lock already covers them: hiding them buys
# nothing and costs a visible Noctalia fade-out that competes with the screen
# transition instead of being hidden behind it.
#
# Only the hide direction is gated, though. Noctalia's dock-hide persists an
# override into settings.toml -- `noctalia msg --help` marks dock-hide/dock-show
# "(persists override)", and unlike desktop-widgets-hide there is no runtime-only
# form -- so a hide that is never followed by its show outlives the session that
# wrote it. A Hyprland logout is exactly that: it hides the chrome and is then
# torn down, leaving the override set for whatever session starts next. Gating
# the show direction too meant niri inherited a disabled dock and had no way to
# clear it, while Hyprland silently repaired itself on its next login. So the
# show direction runs under both compositors, as the idempotent repair it is;
# restoring at logout instead would not help, since the case that strands the
# override is the session dying before any restore can run.
chrome() {
    case "$1" in
        exit | hide-start) [ "$compositor" = hyprland ] || return 0 ;;
    esac
    "$session_chrome" "$@"
}

# The delay is how long niri holds the frozen frame before it starts the
# cross-fade, so it has to outlast whatever is being waited for, and the two
# directions are waiting for different things.
#
# Locking waits on Noctalia's lock surface, which is a QuickShell window and
# takes roughly 600-670ms from "session lock requested" to "session is locked".
# The old 150ms was a hyprlock-era value: the freeze expired half a second
# before the lock existed, the cross-fade ran desktop-to-desktop and was
# therefore invisible, and the lock then appeared abruptly. Overshooting only
# holds the frozen frame a little longer, so this is set above the measured
# worst case rather than at it.
#
# Unlocking is the opposite: the lock surface is already on screen and is torn
# down within a few tens of milliseconds, so a long freeze would just hold a
# still desktop for no reason. Short is right there.
screen_transition() {
    [ "$compositor" = niri ] || return 0
    niri msg action do-screen-transition \
        --delay-ms "${1:-${ORBIT_SCREEN_TRANSITION_MS:-150}}" >/dev/null 2>&1 || true
}

wallpaper_engine_starting_or_running() {
    # SubState, not ActiveState: a unit whose binary is missing crash-loops under
    # Restart=on-failure and reports ActiveState=activating forever, with
    # SubState=auto-restart. That is not an engine about to become ready.
    case "$(systemctl --user show --value --property=SubState \
        orbit-wallpaper-engine.service 2>/dev/null)" in
        running|start|start-pre|start-post) return 0 ;;
        *) return 1 ;;
    esac
}

wait_wallpaper_ready() {
    local deadline="$1" readiness
    wallpaper_engine_starting_or_running || return 1
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if systemctl --user is-active --quiet orbit-wallpaper-engine.service \
            && [ -f "$wallpaper_status" ]; then
            readiness="$(awk -F= '$1 == "readiness" { print $2; exit }' \
                "$wallpaper_status" 2>/dev/null || true)"
            [ "$readiness" = ready ] && return 0
        fi
        sleep 0.05
    done
    return 1
}

wallpaper_transition_start() {
    local command="$1" timeout_seconds="$2" id="orbit-$(date +%s%N)"
    wallpaper_event_file="$(mktemp "$state_dir/event.XXXXXX")" || return 1
    wait_wallpaper_ready "$(deadline_after 2)" || {
        rm -f "$wallpaper_event_file"
        wallpaper_event_file=""
        return 1
    }
    [ -p "$wallpaper_control" ] && [ -p "$wallpaper_events" ] || {
        rm -f "$wallpaper_event_file"
        wallpaper_event_file=""
        return 1
    }
    exec 3<"$wallpaper_events" || {
        rm -f "$wallpaper_event_file"
        wallpaper_event_file=""
        return 1
    }
    (
        timeout "$timeout_seconds" awk -v command="$command" -v id="$id" '
            $0 ~ ("command=" command) && $0 ~ ("id=" id) && $0 ~ "phase=accepted" { accepted = 1 }
            accepted && $0 ~ ("command=" command) && $0 ~ ("id=" id) && $0 ~ "phase=completed" { print; exit }
        ' <&3 >"$wallpaper_event_file"
    ) &
    wallpaper_reader_pid=$!
    if ! timeout 0.5s sh -c 'printf "%s\n" "$1" > "$2"' sh \
        "$command $id" "$wallpaper_control"; then
        kill "$wallpaper_reader_pid" 2>/dev/null || true
        wait "$wallpaper_reader_pid" 2>/dev/null || true
        exec 3<&-
        rm -f "$wallpaper_event_file"
        wallpaper_reader_pid=""
        wallpaper_event_file=""
        return 1
    fi
    log "wallpaper-$command command-issued-ms=$(now_ms)"
    return 0
}

wallpaper_transition_wait() {
    local result=0
    [ -n "$wallpaper_reader_pid" ] || return 1
    wait "$wallpaper_reader_pid" || result=$?
    exec 3<&- || true
    rm -f "$wallpaper_event_file"
    wallpaper_reader_pid=""
    wallpaper_event_file=""
    [ "$result" -eq 0 ]
}

wallpaper_transition() {
    wallpaper_transition_start "$1" "$2" || return 1
    wallpaper_transition_wait
}

stage_workspaces() {
    [ "$compositor" = hyprland ] || return 0
    log "workspace-exit-dispatch-ms=$(now_ms)"
    "$staging" exit >/dev/null 2>&1 && {
        log "workspace-exit-complete-ms=$(now_ms)"
        return 0
    }
    log 'workspace staging failed; attempting recovery'
    "$staging" reset >/dev/null 2>&1 || true
    return 1
}

restore_workspaces() {
    [ "$compositor" = hyprland ] || return 0
    log "workspace-enter-dispatch-ms=$(now_ms)"
    "$staging" reset >/dev/null 2>&1 || {
        log 'workspace restoration failed'
        return 1
    }
    log "workspace-enter-complete-ms=$(now_ms)"
    return 0
}

stage_lock_workspaces() {
    [ "$compositor" = hyprland ] || return 0
    log "session-workspace-lock-dispatch-ms=$(now_ms)"
    "$session_workspaces" lock-start >/dev/null && {
        log "session-workspace-lock-complete-ms=$(now_ms)"
        return 0
    }
    log 'session workspace lock staging failed; attempting recovery'
    "$session_workspaces" recover >/dev/null 2>&1 || true
    return 1
}

wait_lock_workspaces() {
    [ "$compositor" = hyprland ] || return 0
    "$session_workspaces" lock-wait >/dev/null 2>&1 || {
        log 'session workspace lock wait failed'
        return 1
    }
}

restore_lock_workspaces() {
    [ "$compositor" = hyprland ] || return 0
    log "session-workspace-unlock-dispatch-ms=$(now_ms)"
    "$session_workspaces" unlock >/dev/null 2>&1 || {
        log 'session workspace restoration failed'
        return 1
    }
    log "session-workspace-unlock-complete-ms=$(now_ms)"
    return 0
}

restore_visual_desktop() {
    local wallpaper_ok=0
    restore_workspaces || true
    # Workspace motion is the visual anchor; wallpaper follows after the overlap.
    sleep "$visual_overlap_seconds"
    wallpaper_transition_start intro 8 && wallpaper_ok=1 || true
    [ "$wallpaper_ok" -eq 1 ] && wallpaper_transition_wait || true
}

run_login() {
    local wallpaper_ok=0
    set_state preparing login
    wait_noctalia_ready "$(deadline_after 5)" || log 'Noctalia readiness unavailable; continuing'
    "$session_sound" desktop-login >/dev/null 2>&1 &
    chrome intro || log 'Noctalia session chrome intro unavailable'
    wait_wallpaper_ready "$(deadline_after 2)" || log 'Wallpaper readiness unavailable during login'
    set_state transitioning login
    restore_lock_workspaces || log 'login workspace restoration failed'
    wallpaper_transition_start intro 8 && wallpaper_ok=1 || \
        log 'Wallpaper intro unavailable during login'
    [ "$wallpaper_ok" -eq 1 ] && wallpaper_transition_wait || true
    set_state interactive "wallpaper=$wallpaper_ok"
    return 0
}

run_unlock() {
    local wallpaper_ok=0
    # No screen transition here, and not for want of trying to place one.
    #
    # Noctalia's lock is an ext-session-lock-v1 client, so the compositor owns
    # the locked state and unlock_and_destroy reveals the desktop atomically.
    # There is no instant at which an external client can freeze the locked
    # frame: issued from Noctalia's own session_unlocked hook, which fires in
    # the same millisecond as the unlock request and before logind's hint is
    # cleared, niri's screen transition still produced nothing. Noctalia does
    # not animate its lock surface away either; unlock_and_destroy is called
    # directly. So the unlock is abrupt, and that is a property of the lock
    # protocol rather than a timing that can be tuned.
    #
    # Locking is unaffected: there the transition is issued while still
    # unlocked, which is why it has an ordinary frame to freeze.
    "$session_sound" desktop-unlock >/dev/null 2>&1 &
    wallpaper_transition_start intro 8 && wallpaper_ok=1 || \
        log 'Wallpaper intro unavailable during unlock'
    chrome intro || log 'Noctalia session chrome intro unavailable during unlock'
    set_state preparing unlock
    wait_wallpaper_ready "$(deadline_after 2)" || log 'Wallpaper readiness unavailable during unlock'
    set_state transitioning unlock
    restore_lock_workspaces || log 'unlock workspace restoration failed'
    [ "$wallpaper_ok" -eq 1 ] && wallpaper_transition_wait || true
    set_state interactive "wallpaper=$wallpaper_ok"
    return 0
}

run_lock() {
    local wallpaper_ok=0 hyprlock_status=1 attempt
    if pidof hyprlock >/dev/null 2>&1; then
        set_state locked existing-hyprlock
        return 0
    fi
    # Sound begins with the visual workspace transition and must not block it.
    set_state preparing lock
    wait_wallpaper_ready "$(deadline_after 2)" || log 'Wallpaper readiness unavailable during lock'
    set_state transitioning lock
    stage_lock_workspaces || log 'lock staging unavailable; lock continues'
    "$session_sound" desktop-lock >/dev/null 2>&1 &
    chrome hide-start || log 'Noctalia session chrome exit unavailable during lock'
    wait_lock_workspaces || log 'lock workspace wait unavailable; lock continues'
    wallpaper_transition_start exit 3 && wallpaper_ok=1 || \
        log 'Wallpaper exit unavailable; lock continues'
    [ "$wallpaper_ok" -eq 1 ] && wallpaper_transition_wait || true

    screen_transition "${ORBIT_SCREEN_TRANSITION_LOCK_MS:-800}"
    for attempt in 1 2; do
        "$hyprlock_bin"
        hyprlock_status=$?
        [ "$hyprlock_status" -eq 0 ] && break
        [ "$attempt" -eq 1 ] && sleep 0.25
    done

    if [ "$hyprlock_status" -ne 0 ]; then
        log 'Hyprlock failed twice; restoring interactive desktop'
        restore_lock_workspaces || true
        chrome intro || true
        set_state interactive hyprlock-failed
        return 1
    fi

    run_unlock
}

run_terminal_action() {
    local action="$1" dry_run="${2:-0}" wallpaper_ok=0
    set_state preparing "$action"
    if [ "$action" = logout ]; then
        chrome exit || log 'Noctalia session chrome exit unavailable'
    fi
    wait_wallpaper_ready "$(deadline_after 2)" || log "Wallpaper readiness unavailable during $action"
    set_state transitioning "$action"
    stage_workspaces || log 'terminal-action staging unavailable; action continues'
    sleep "$visual_overlap_seconds"
    wallpaper_transition_start exit 3 && wallpaper_ok=1 || \
        log 'Wallpaper exit unavailable; terminal action continues'
    [ "$wallpaper_ok" -eq 1 ] && wallpaper_transition_wait || true

    if [ "$dry_run" = 1 ]; then
        restore_workspaces || true
        [ "$action" = logout ] && chrome intro || true
        set_state interactive "dry-run wallpaper=$wallpaper_ok"
        printf 'DRY_RUN_READY_BEFORE_SESSION_EXIT action=%s\n' "$action"
        return 0
    fi

    if [ "$action" = logout ]; then
        "$session_sound" desktop-logout || log 'logout sound unavailable'
    fi

    systemctl --user stop "$session_target" || log 'session target stop failed; loginctl still proceeds'
    case "$action" in
        logout)
            if ! loginctl terminate-session "${XDG_SESSION_ID:?}"; then
                chrome intro || true
                set_state interactive logout-failed
                return 1
            fi
            ;;
        restart) exec loginctl reboot ;;
        shutdown) exec loginctl poweroff ;;
    esac
}

main() {
    local command="${1:-status}" dry_run=0
    shift || true
    case "$command" in
        status) status; return 0 ;;
        login) run_login; return $? ;;
        lock) run_lock; return $? ;;
        unlock) run_unlock; return $? ;;
        logout|restart|shutdown)
            [ "${1:-}" = --dry-run ] && dry_run=1
            run_terminal_action "$command" "$dry_run"
            return $? ;;
        *)
            printf 'usage: %s {status|login|lock|unlock|logout|restart|shutdown [--dry-run]}\n' "${0##*/}" >&2
            return 2 ;;
    esac
}

if [ "${1:-status}" = status ]; then
    main "$@"
    exit $?
fi

exec 9>"$lock_file"
if ! flock -n 9; then
    log 'another transition is already active'
    exit 1
fi
main "$@"
