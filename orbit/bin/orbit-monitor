#!/usr/bin/env python3
"""Resolve physical monitors and stable monitor identities."""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
from pathlib import Path

def monitors() -> list[dict]:
    try:
        result = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            check=True,
            capture_output=True,
            text=True,
        )
        value = json.loads(result.stdout)
    except FileNotFoundError as error:
        raise SystemExit("hyprctl is not installed or not in PATH") from error
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.stderr.strip() or "Hyprland is not running") from error
    except json.JSONDecodeError as error:
        raise SystemExit(f"Could not parse Hyprland monitor data: {error}") from error

    if not isinstance(value, list):
        raise SystemExit("Hyprland returned an invalid monitor list")
    return value


def normalized(value: object) -> str:
    return " ".join(str(value or "").casefold().split())


def monitor_identity(monitor: dict) -> str:
    """Return the stable identity used by recording and monitor configuration."""
    serial = normalized(monitor.get("serial"))
    if serial:
        return f"serial:{serial}"
    make = normalized(monitor.get("make"))
    model = normalized(monitor.get("model"))
    if make or model:
        return f"display:{make}|{model}"
    description = normalized(monitor.get("description"))
    if description:
        return f"description:{description}"
    return f"connector:{normalized(monitor.get('name'))}"


def transition_workspace_id(identity: str) -> str:
    """Return a private ordinary workspace ID stable across connector changes."""
    digest = hashlib.sha256(normalized(identity).encode()).hexdigest()
    return str(9100 + (int(digest[:8], 16) % 900))


def transition_workspaces(available: list[dict]) -> list[tuple[str, str, str]]:
    result = []
    for monitor in available:
        identity = monitor_identity(monitor)
        result.append((str(monitor["name"]), identity, transition_workspace_id(identity)))
    return result


def resolve_identity(identity: str, available: list[dict]) -> str:
    wanted = normalized(identity)
    for monitor in available:
        if wanted in {normalized(monitor_identity(monitor)), normalized(monitor.get("name"))}:
            return str(monitor["name"])
    raise SystemExit(f"Configured monitor is unavailable: {identity}")


def main() -> None:
    parser = argparse.ArgumentParser(prog="orbit-monitor")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("list")

    subparsers.add_parser("transition-workspaces")

    resolve = subparsers.add_parser("monitor-for-identity")
    resolve.add_argument("identity")

    subparsers.add_parser("instant-replay-monitor")

    args = parser.parse_args()
    available = monitors() if args.command in {
        "list",
        "monitor-for-identity",
        "instant-replay-monitor",
    } else []

    if args.command == "list":
        for monitor in available:
            marker = "*" if monitor.get("focused") else " "
            print(f"{marker} {monitor.get('name', 'unknown')}: {monitor_identity(monitor)}")
        return
    if args.command == "transition-workspaces":
        for name, identity, workspace in transition_workspaces(monitors()):
            print(f"{name}\t{identity}\t{workspace}")
        return
    if args.command == "monitor-for-identity":
        print(resolve_identity(args.identity, available))
        return
    if args.command == "instant-replay-monitor":
        focused = next((monitor for monitor in available if monitor.get("focused")), None)
        print((focused or available[0])["name"])
        return


if __name__ == "__main__":
    main()
