#!/usr/bin/env python3
"""
Generate hyprlock-colors.conf from Orbit's generated Noctalia semantic data.

This script reads the already-generated semantic adapter and generates
color variable assignments for hyprlock.conf to use via `source = ...`.

The generated file contains Hyprlock color directives that can be sourced:
  source = ~/.config/hypr/hyprlock-colors.conf

Usage:
  generate-hyprlock-colors              # Generate for current palette
  generate-hyprlock-colors <palette>    # Generate for specific palette
"""

import json
import sys
from pathlib import Path


GENERATED = Path.home() / ".config/orbit/generated/noctalia/semantic.json"
OUTPUT = Path.home() / ".config/hypr/hyprlock-colors.conf"
HYPRLOCK = Path.home() / ".config/hypr/hyprlock.conf"
APPEARANCE_SOURCE = Path.home() / ".config/hypr/appearance.toml"


def get_selected_palette() -> str:
    return "noctalia"


def load_palette(name: str) -> dict:
    """Load Orbit's semantic adapter generated by the caller."""
    if name not in ("noctalia", "noctalia.lua"):
        raise SystemExit("Orbit accepts only the active Noctalia palette")
    try:
        return json.loads(GENERATED.read_text())["semantic"]
    except (OSError, KeyError, json.JSONDecodeError) as error:
        raise SystemExit(f"Orbit semantic output is unavailable: {GENERATED}") from error


def display_font_family() -> str:
    try:
        import tomllib
        with APPEARANCE_SOURCE.open("rb") as stream:
            family = tomllib.load(stream).get("typography", {}).get("display", {}).get("family", "")
    except (OSError, AttributeError, tomllib.TOMLDecodeError):
        family = ""
    return str(family).strip() or "JetBrains Mono"


def update_hyprlock_font_family(family: str) -> None:
    try:
        text = HYPRLOCK.read_text()
    except OSError:
        return
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if line.strip().startswith("font_family ="):
            indentation = line[: len(line) - len(line.lstrip())]
            lines[index] = f"{indentation}font_family = {family}"
    HYPRLOCK.write_text("\n".join(lines).rstrip() + "\n")


def generate_hyprlock_colors(palette_name: str) -> None:
    """
    Generate hyprlock color configuration.

    Maps Orbit palette colors to Hyprlock usage:
      - text: accent (bright color for labels and time)
      - secondary_text: accent_secondary (alternate accent)
      - accent_border: accent (input field border)
      - surface: background (input field background; palette adapter name)
      - text_color: text (fallback foreground text)
    """
    colors = load_palette(palette_name)
    update_hyprlock_font_family(display_font_family())

    # Map palette colors to Hyprlock variables
    # Hyprlock format: $varname = rgb(rrggbb)
    text = colors["accent"]
    secondary = colors["accent_secondary"]
    border = colors["accent"]
    surface = colors["window_background"]
    text_color = colors["text"]

    # Remove '#' for rgb() format
    text_rgb = text[1:] if text.startswith("#") else text
    secondary_rgb = secondary[1:] if secondary.startswith("#") else secondary
    border_rgb = border[1:] if border.startswith("#") else border
    surface_rgb = surface[1:] if surface.startswith("#") else surface
    text_color_rgb = text_color[1:] if text_color.startswith("#") else text_color

    # Generate config
    content = f"""# Generated by generate-hyprlock-colors. Do not edit manually.
# Colors sourced from Orbit palette: {palette_name}
#
# These variables are used by hyprlock.conf for lock screen appearance.
# To change colors globally, change the Noctalia palette, then refresh adapters.

$time_color = rgb({text_rgb})
$date_color = rgb({secondary_rgb})
$border_color = rgb({border_rgb})
$surface_color = rgb({surface_rgb})
$text_color = rgb({text_color_rgb})
"""

    # Write atomically
    import tempfile
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".conf", dir=OUTPUT.parent, delete=False
    ) as tmp:
        tmp.write(content)
        tmp_path = tmp.name

    Path(tmp_path).replace(OUTPUT)
    print(f"Generated {OUTPUT}")


def main():
    palette = sys.argv[1] if len(sys.argv) > 1 else get_selected_palette()
    generate_hyprlock_colors(palette)


if __name__ == "__main__":
    main()
