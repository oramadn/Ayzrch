#!/usr/bin/env bash
set -euo pipefail

title='Orbit Wallpaper Engine'

# Reuse the existing settings window instead of creating duplicate UI processes.
existing_address=$(orbit-compositor clients 2>/dev/null | jq -r --arg title "$title" '
    ([.[] | select(.title == $title) | .address] | first) // ""')
if [[ -n "$existing_address" ]]; then
    exec orbit-compositor dispatch focus-window "$existing_address"
fi

# The accepted Orbit placement policy — active monitor, top-right, 20px gap — is
# a window rule in both compositors' configuration rather than an argument to
# the launch, so the settings window only has to be started.
exec orbit-launch --shell-command orbit-wallpaper-settings
