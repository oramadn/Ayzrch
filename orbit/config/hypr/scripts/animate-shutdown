#!/bin/sh

set -eu

action="${1:-logout}"

usage() {
    printf 'usage: %s [logout|restart|shutdown]\n' "$0" >&2
}

if [ "$#" -gt 1 ]; then
    usage
    exit 2
fi

case "$action" in
    logout)
        confirmation_title='End Hyprland session?'
        confirmation_text='Save your work before ending the current graphical session.'
        confirmation_label='End session'
        ;;
    restart)
        confirmation_title='Restart computer?'
        confirmation_text='Save your work before restarting the computer.'
        confirmation_label='Restart'
        ;;
    shutdown)
        confirmation_title='Shut down computer?'
        confirmation_text='Save your work before shutting down the computer.'
        confirmation_label='Shut down'
        ;;
    *)
        usage
        exit 2
        ;;
esac

if [ "$action" = logout ] && [ -z "${XDG_SESSION_ID:-}" ]; then
    printf 'XDG_SESSION_ID is unavailable; refusing to terminate the session.\n' >&2
    exit 1
fi

if ! command -v zenity >/dev/null 2>&1; then
    printf 'Shutdown confirmation is unavailable; refusing to terminate the session.\n' >&2
    exit 1
fi

if ! zenity --question \
    --title="$confirmation_title" \
    --text="$confirmation_text" \
    --ok-label="$confirmation_label" \
    --cancel-label='Cancel'; then
    exit 0
fi

exec "$HOME/.local/bin/orbit-session-transition" "$action"
